# NODE_ENV=development
# PORT=5000
# CLIENT_URL=http://localhost:5173
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME
# SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_VALUE
# ADMIN_SESSION_IDLE_MINUTES=30
# ADMIN_SESSION_ABSOLUTE_HOURS=12
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# LOGIN_RATE_LIMIT_MAX=100
# DELEGATE_REGISTRATION_RATE_LIMIT_WINDOW_MS=900000
# DELEGATE_REGISTRATION_RATE_LIMIT_MAX=100
# COMMERCIAL_APPLICATION_RATE_LIMIT_WINDOW_MS=900000
# COMMERCIAL_APPLICATION_RATE_LIMIT_MAX=100
# ABSTRACT_SUBMISSION_DEADLINE=2027-03-15T23:59:59+01:00
# ABSTRACT_CONTINUATION_TOKEN_TTL_HOURS=24
# ABSTRACT_RECOVERY_TOKEN_TTL_MINUTES=30
# ABSTRACT_RATE_LIMIT_WINDOW_MS=900000
# ABSTRACT_RATE_LIMIT_MAX=100
# ENQUIRY_RATE_LIMIT_WINDOW_MS=900000
# ENQUIRY_RATE_LIMIT_MAX=100
# ENQUIRY_NOTIFICATION_ROLES=SUPER_ADMIN,COMMUNICATIONS
# STUDENT_EVIDENCE_STORAGE_DIR=.private/student-evidence
# STUDENT_EVIDENCE_TOKEN_TTL_HOURS=24
# STUDENT_EVIDENCE_RATE_LIMIT_WINDOW_MS=900000
# STUDENT_EVIDENCE_RATE_LIMIT_MAX=100
# STUDENT_VERIFICATION_RECOVERY_TOKEN_TTL_MINUTES=30
# STUDENT_VERIFICATION_WORKFLOW_RATE_LIMIT_WINDOW_MS=900000
# STUDENT_VERIFICATION_WORKFLOW_RATE_LIMIT_MAX=100
# ADMIN_INVITATION_RATE_LIMIT_WINDOW_MS=900000
# ADMIN_INVITATION_VALIDATE_RATE_LIMIT_MAX=500
# ADMIN_INVITATION_ACCEPT_RATE_LIMIT_MAX=100
# ADMIN_INVITATION_EXPIRY_HOURS=48
# ADMIN_ALLOWED_EMAIL_DOMAINS=aiaiacafrica.com,aiaiacwestafrica.com
# ADMIN_FRONTEND_URL=http://localhost:5173

# Transactional Admin invitation email. Never expose these values to Vite/frontend code.
# MAILJET_API_KEY=
# MAILJET_SECRET_KEY=
# MAILJET_FROM_EMAIL=no-reply@example.com
# MAILJET_FROM_NAME=AIAIAC

# Bulk campaign confirmation/delivery is disabled until recipient consent/policy and Mailjet
# sending limits are approved. Test-send and preview are separate from this switch.
# COMMUNICATIONS_BULK_SEND_ENABLED=false

# Paystack server-side test configuration. Never expose this key to Vite/frontend code.
# PAYSTACK_SECRET_KEY=
# PAYSTACK_CALLBACK_URL=http://localhost:5173/registration/payment/callback
# PAYMENT_NOTIFICATION_ROLES=SUPER_ADMIN

# Set these temporarily only when running npm run admin:create-super, then remove them.
# INITIAL_SUPER_ADMIN_NAME=Conference Owner
# INITIAL_SUPER_ADMIN_EMAIL=owner@example.com
# INITIAL_SUPER_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD
